# Dev credentials — used by `vite dev` and `drizzle-kit` commands.
# In production, set these as real environment variables via systemd/PM2
# (process env always takes precedence over this file).

DATABASE_URL="postgres://root:yourpassword@localhost:5432/local"
# Read by compose.yaml (`npm run db:start`); keep it in step with DATABASE_URL
POSTGRES_PASSWORD="yourpassword"
ORIGIN="http://127.0.0.1:9002"

# Better Auth
# For production use 32 characters generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Spotify (create app at https://developer.spotify.com/dashboard)
# Set redirect URI in dashboard to: {ORIGIN}/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:9002/api/auth/callback/spotify"

# Simulation mode: when true, unauthenticated visitors see a demo path instead of
# being blocked by Spotify's restricted-app policy. Invited users can still log in normally.
SIMULATIONMODE=false
